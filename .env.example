# Optional PostgreSQL connection. Set in the backend process environment.
# Unset DATABASE_URL => explicitly labeled SQLite development fallback in backend/data/moneyfy.db.
# DATABASE_URL=postgresql+psycopg://moneyfy:YOUR_PASSWORD@127.0.0.1:5432/moneyfy
# MONEYFY_POSTGRES_PASSWORD=choose-a-local-password-for-compose
# MONEYFY_ENV=production requires an explicit database URL.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,https://localhost
# Frontend config belongs in frontend/.env.local or frontend/.env.android.local.
# Blank = offline demo. Android must use a reachable HTTPS API, never laptop localhost.
VITE_API_BASE_URL=
