  "components": {
    "schemas": {
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "merchant": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "credit",
              "debit"
            ]
          },
          "category": {
            "type": "string"
          },
          "bank": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "date",
          "merchant",
          "amount",
          "direction",
          "category",
          "bank"
        ],
        "additionalProperties": false
      },
      "Goal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "target": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "saved": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "High",
              "Normal"
            ]
          }
        },
        "required": [
          "name",
          "target",
          "saved",
          "deadline",
          "priority"
        ],
        "additionalProperties": false
      },
      "Scenario": {
        "type": "object",
        "properties": {
          "food_reduction_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "shopping": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "purchase": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "salary_delay_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          },
          "emergency": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "additional_savings": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "goal_target_increase": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "ForecastPoint": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "baseline_balance": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only"
          },
          "proposed_balance": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only"
          },
          "scenario_balance": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only"
          }
        },
        "required": [
          "date",
          "baseline_balance",
          "proposed_balance",
          "scenario_balance"
        ],
        "additionalProperties": false
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "balance": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only"
          },
          "lowest_balance": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only"
          },
          "closing_balance": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only"
          },
          "safe_to_spend": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "daily_budget": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "savings_capacity": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "forecast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "as_of",
          "balance",
          "forecast",
          "assumptions"
        ],
        "additionalProperties": false
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "calculation": {
            "type": "string"
          },
          "monthly_impact": {
            "type": "integer",
            "format": "int64",
            "description": "Integer paise; INR only",
            "minimum": 0
          },
          "action": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "priority",
          "issue",
          "evidence",
          "calculation",
          "monthly_impact",
          "action",
          "uncertainty",
          "status"
        ],
        "additionalProperties": false
