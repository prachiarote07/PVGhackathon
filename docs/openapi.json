  "components": {
    "schemas": {
      "AlertState": {
        "properties": {
          "read": {
            "type": "boolean",
            "title": "Read",
            "default": false
          },
          "dismissed": {
            "type": "boolean",
            "title": "Dismissed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AlertState"
      },
      "Bill": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "amount": {
            "type": "integer",
            "maximum": 100000000000.0,
            "minimum": 0.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "title": "Duedate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "amount",
          "dueDate"
        ],
        "title": "Bill"
      },
      "Body_import_csv_api_v1_imports_csv_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_csv_api_v1_imports_csv_post"
      },
      "CategoryUpdate": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "Income",
              "Food",
              "Housing",
              "Transport",
              "Subscriptions",
              "Fees",
              "Bills",
              "Shopping",
              "Health",
              "Education",
              "Other",
              "Uncategorized"
            ],
            "title": "Category"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "version"
        ],
        "title": "CategoryUpdate"
      },
      "Confirmed": {
        "properties": {
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmed"
        ],
        "title": "Confirmed"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Decision": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected"
            ],
            "title": "Status"
          },
          "amount": {
            "type": "integer",
            "maximum": 100000000000.0,
            "minimum": 0.0,
            "title": "Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "amount"
        ],
        "title": "Decision"
      },
      "FinancialState": {
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date",
            "title": "Asof"
          },
          "nextPayday": {
            "type": "string",
            "format": "date",
            "title": "Nextpayday"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "type": "array",
            "maxItems": 5000,
            "title": "Transactions"
          },
          "balance": {
            "type": "integer",
            "maximum": 100000000000.0,
            "minimum": 0.0,
            "title": "Balance",
            "default": 0
          },
          "reserve": {
            "type": "integer",
            "maximum": 100000000000.0,
            "minimum": 0.0,
            "title": "Reserve",
            "default": 0
          },
          "salary": {
            "type": "integer",
            "maximum": 100000000000.0,
            "minimum": 0.0,
            "title": "Salary",
            "default": 0
          },
          "bills": {
            "items": {
              "$ref": "#/components/schemas/Bill"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Bills"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          },
          "connections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Connections"
          },
          "imports": {
            "items": {
              "$ref": "#/components/schemas/ImportLog"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Imports"
          },
          "decisions": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Decisions"
          },
          "alerts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AlertState"
            },
            "type": "object",
            "maxProperties": 300,
            "title": "Alerts"
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/Goal"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Goals"
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ],
            "title": "Theme",
            "default": "light"
          },
          "schedules": {
            "items": {
              "$ref": "#/components/schemas/Schedule"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Schedules"
          },
          "occurrences": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Occurrence"
            },
            "type": "object",
            "maxProperties": 10000,
            "title": "Occurrences"
          },
          "patternDecisions": {
            "additionalProperties": {
              "$ref": "#/components/schemas/PatternDecision"
            },
            "type": "object",
            "maxProperties": 500,
            "title": "Patterndecisions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asOf",
          "nextPayday"
        ],
        "title": "FinancialState"
      },
      "Goal": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
