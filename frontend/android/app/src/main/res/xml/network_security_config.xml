<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No HTTP, user-installed CA override, or trust-all development bypass. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
