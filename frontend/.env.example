# Copy to .env.local for the website, or .env.android.local for Android.
# Blank means offline demo. No backend is implemented at checkpoint 1.
# VITE variables are bundled into the app: never put passwords or secrets here.
VITE_API_BASE_URL=
# Android: use your actual trusted HTTPS endpoint, for example:
# VITE_API_BASE_URL=https://YOUR-API-HOST/api/v1
# A phone's localhost is the phone, not this laptop. See docs/ANDROID.md.
